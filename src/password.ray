// Generación y normalización de la contraseña fuera de banda.
import std/crypto;
import std/hex;

/// 8 CSPRNG bytes → `xxxx-xxxx-xxxx-xxxx` (lowercase hex).
pub fn generate() -> string {
    format_hex(hex.hex_encode(crypto.random_bytes(8)))
}

/// Strips dashes/spaces and lowercases for compare/derive.
pub fn normalize(raw: string) -> string {
    let lower = raw.trim().to_lower();
    lower.replace("-", "").replace(" ", "")
}

fn format_hex(h: string) -> string {
    // 16 hex chars → cuatro grupos de 4
    h.substring(0, 4)
        + "-"
        + h.substring(4, 8)
        + "-"
        + h.substring(8, 12)
        + "-"
        + h.substring(12, 16)
}

@test
fn normalize_strips_dashes() {
    assert(normalize("AbCd-Ef01-2345-6789") == "abcdef0123456789");
}

@test
fn generate_shape() {
    let p = generate();
    assert(p.len() == 19);
    assert(normalize(p).len() == 16);
}
