// Modo send: escucha, autentica y envía el archivo cifrado (streaming).
import std/net;
import std/fs;
import std/crypto;
import framing;
import protocol;
import password;
import kdf;
import progress;
import streamhash;
import fileread;

pub struct SendOpts {
    path: string,
    bind: string,
    port: int,
    timeout_ms: int,
}

fn basename(path: string) -> string {
    let parts = path.split("/");
    if (parts.len() == 0) {
        return path;
    }
    let last = parts[parts.len() - 1];
    if (last.len() == 0) { path } else { last }
}

pub fn run(opts: SendOpts) -> int {
    match (fs.file_size(opts.path)) {
        Result.Err(e) => {
            eprint("could not read file: " + e);
            1
        },
        Result.Ok(size) => match (net.tcp_listen(opts.bind, opts.port)) {
            Result.Err(e) => {
                eprint("could not listen: " + e);
                1
            },
            Result.Ok(listener) => {
                let port = net.local_port(listener);
                let pw = password.generate();
                let salt = crypto.random_bytes(protocol.SALT_LEN);
                let key = kdf.derive_key(password.normalize(pw), salt);
                let name = basename(opts.path);
                print("Password: " + pw);
                print("Waiting on " + opts.bind + ":" + to_string(port) + " …");
                print(
                    "Receiver should run: takeit recv --host <this-ip> --port "
                        + to_string(port)
                        + " --password "
                        + pw
                );
                if (opts.timeout_ms > 0) {
                    eprint("(idle/accept timeout: " + to_string(opts.timeout_ms / 1000) + "s)");
                    net.set_read_timeout(listener, opts.timeout_ms);
                }
                match (net.tcp_accept(listener)) {
                    Result.Err(e) => {
                        if (e == "read timeout") {
                            eprint("timed out waiting for receiver");
                        } else {
                            eprint("accept: " + progress.map_io_err(e));
                        }
                        close(listener);
                        1
                    },
                    Result.Ok(sock) => {
                        close(listener);
                        var c0 = framing.from_handle(sock);
                        c0 = framing.set_timeout(c0, opts.timeout_ms);
                        let hello = protocol.Hello {
                            salt: salt,
                            name: name,
                            size: size,
                            chunk_size: protocol.DEFAULT_CHUNK
                        };
                        match (protocol.send_hello(c0, hello)) {
                            Result.Err(e) => {
                                eprint(e);
                                framing.close_conn(c0);
                                1
                            },
                            Result.Ok(c1) => match (protocol.auth_as_sender(c1, key)) {
                                Result.Err(e) => {
                                    eprint(e);
                                    framing.close_conn(c1);
                                    1
                                },
                                Result.Ok(c2) => {
                                    let code = match (stream_file(
                                        c2,
                                        key,
                                        name,
                                        size,
                                        opts.path,
                                        protocol.DEFAULT_CHUNK
                                    )) {
                                        Result.Err(e) => {
                                            eprint("\n" + e);
                                            1
                                        },
                                        Result.Ok(sent) => {
                                            let note = if (sent.offset > 0) {
                                                ", resumed at " + progress.format_bytes(sent.offset)
                                            } else {
                                                ""
                                            };
                                            print(
                                                "Sent: "
                                                    + name
                                                    + " ("
                                                    + progress.format_bytes(size)
                                                    + note
                                                    + ")"
                                            );
                                            0
                                        },
                                    };
                                    framing.close_conn(c2);
                                    code
                                },
                            },
                        }
                    },
                }
            },
        },
    }
}

/// A finished transfer: where the data started (the prefix the receiver already had) and
/// how many file bytes crossed the wire.
pub struct Sent {
    offset: int,
    sent: int,
}

/// Agrees where the data starts: the receiver's offset when its prefix matches this file
/// byte for byte, 0 otherwise (a different file, a torn tail, an offset past the end).
/// Returns the offset and the hasher to go on with, already fed with that prefix.
fn agree_offset(
    r: protocol.Resume,
    path: string,
    size: int,
    hh: int
) -> Result<(int, int), string> {
    if (r.offset == 0 || r.offset > size) {
        return Result.Ok((0, hh));
    }
    let prefix = match (streamhash.prefix_of(path, r.offset, protocol.DEFAULT_CHUNK, hh)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(d) => d,
    };
    if (crypto.constant_time_eq(prefix, r.prefix_digest)) {
        return Result.Ok((r.offset, hh));
    }
    match (streamhash.restart(hh)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(fresh) => Result.Ok((0, fresh)),
    }
}

/// Sender side of an authenticated session: reads the receiver's resume offer, answers
/// with the start offset, streams the rest of `path` in `chunk`-byte pieces and waits for
/// the final ACK.
pub fn stream_file(
    c: framing.Conn,
    key: bytes,
    name: string,
    size: int,
    path: string,
    chunk: int
) -> Result<Sent, string> {
    let offer = match (protocol.recv_sealed(c, key, protocol.FROM_RECEIVER, 0, name, size)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(ch) => ch,
    };
    if (offer.kind != protocol.KIND_RESUME) {
        return Result.Err("expected a resume frame, got kind " + to_string(offer.kind));
    }
    let resume = match (protocol.decode_resume(offer.body)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(r) => r,
    };
    let fresh = match (streamhash.init()) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(h) => h,
    };
    let (start, hh) = match (agree_offset(resume, path, size, fresh)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(pair) => pair,
    };
    if (start > 0) {
        eprint("receiver already has " + progress.format_bytes(start) + "; sending the rest");
    } else if (resume.offset > 0) {
        eprint("receiver's partial file does not match; sending from the start");
    }
    var conn = match (protocol.send_chunk(
        offer.conn,
        key,
        0,
        name,
        size,
        protocol.KIND_START,
        protocol.be64(start)
    )) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(c1) => c1,
    };

    var index = 1;
    var offset = start;
    var meter = progress.start_from("sending", size, start);
    var send_err = "";
    match (fileread.for_each_chunk_from(path, start, chunk, fn(piece: bytes) -> Result<int, string> {
        if (send_err.len() > 0) {
            return Result.Err(send_err);
        }
        match (protocol.send_chunk(conn, key, index, name, size, protocol.KIND_DATA, piece)) {
            Result.Err(e) => {
                send_err = e;
                Result.Err(e)
            },
            Result.Ok(c2) => {
                conn = c2;
                match (streamhash.update(hh, piece)) {
                    Result.Err(e) => {
                        send_err = e;
                        Result.Err(e)
                    },
                    Result.Ok(_) => {
                        index = index + 1;
                        offset = offset + piece.len();
                        meter = progress.tick(meter, offset);
                        Result.Ok(0)
                    },
                }
            },
        }
    })) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(_) => { },
    }

    if (offset != size) {
        return Result.Err(
            "read size (" + to_string(offset) + ") != expected (" + to_string(size) + ")"
        );
    }

    let digest = match (streamhash.digest(hh)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(d) => d,
    };

    match (protocol.send_chunk(conn, key, index, name, size, protocol.KIND_DONE, digest)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(c3) => match (framing.read_frame(c3, 16)) {
            Result.Err(e) => Result.Err("waiting for ACK: " + e),
            Result.Ok(pair) => {
                let (_c4, ack) = pair;
                if (ack == b"OK") {
                    progress.finish(meter);
                    Result.Ok(Sent { offset: start, sent: size - start })
                } else {
                    Result.Err("unexpected ACK")
                }
            },
        },
    }
}
