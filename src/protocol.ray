// Protocolo takeit v3: hello, auth, resume/start, chunks AEAD, done.
// v2 (raylang M126): el hash de integridad es el SHA-256 real del texto plano
// (hasher incremental), no el encadenado dependiente de fronteras de v1.
// v3: reanudación. Tras el auth, el receptor declara cuántos bytes ya tiene (y el
// SHA-256 de ese prefijo); el emisor responde desde qué offset envía. El receptor
// también cifra, así que cada dirección tiene su propio espacio de nonces. Wire
// incompatible: peers de versiones distintas se rechazan en el hello.
import std/crypto;
import framing;
import kdf;

pub const VERSION: int = 3;

pub const SALT_LEN: int = 16;

/// 256 KiB: fewer AEAD frames and better throughput on large files.
pub const DEFAULT_CHUNK: int = 262144;

pub const MAX_FRAME: int = 262400;

pub const MAGIC: bytes = b"TAKE";

/// Sealed frame kinds (first plaintext byte).
pub const KIND_DATA: int = 1;

pub const KIND_DONE: int = 2;

/// Receiver → sender, its first sealed frame: bytes already held + SHA-256 of them.
pub const KIND_RESUME: int = 3;

/// Sender → receiver, its first sealed frame: the offset the data starts at.
pub const KIND_START: int = 4;

/// Nonce direction tags. Both peers seal with the same key, so each direction owns a
/// disjoint nonce space: a receiver frame never reuses a sender nonce.
pub const FROM_SENDER: int = 0;

pub const FROM_RECEIVER: int = 1;

pub struct Hello {
    salt: bytes,
    name: string,
    size: int,
    chunk_size: int,
}

pub fn be64(n: int) -> bytes {
    bytes_of(
        [
            n >> 56 & 255,
            n >> 48 & 255,
            n >> 40 & 255,
            n >> 32 & 255,
            n >> 24 & 255,
            n >> 16 & 255,
            n >> 8 & 255,
            n & 255
        ]
    )
}

pub fn read_be64(b: bytes) -> int {
    var n = 0;
    var i = 0;
    while (i < 8) {
        n = n * 256 + (b[i] & 255);
        i = i + 1;
    }
    n
}

fn be32(n: int) -> bytes {
    bytes_of([n >> 24 & 255, n >> 16 & 255, n >> 8 & 255, n & 255])
}

fn read_be32(b: bytes) -> int {
    (b[0] & 255) << 24 | (b[1] & 255) << 16 | (b[2] & 255) << 8 | b[3] & 255
}

fn encode_hello(h: Hello) -> bytes {
    let name_b = h.name.to_bytes();
    MAGIC
        + bytes_of([VERSION])
        + h.salt
        + be32(name_b.len())
        + name_b
        + be64(h.size)
        + be32(h.chunk_size)
}

fn decode_hello(payload: bytes) -> Result<Hello, string> {
    if (payload.len() < 4 + 1 + SALT_LEN + 4 + 8 + 4) {
        return Result.Err("hello too short");
    }
    if (payload.sub_bytes(0, 4) != MAGIC) {
        return Result.Err("invalid magic");
    }
    if ((payload[4] & 255) != VERSION) {
        return Result.Err("unsupported version");
    }
    let salt = payload.sub_bytes(5, 5 + SALT_LEN);
    var off = 5 + SALT_LEN;
    let name_len = read_be32(payload.sub_bytes(off, off + 4));
    off = off + 4;
    if (name_len < 0 || off + name_len + 8 + 4 > payload.len()) {
        return Result.Err("invalid name in hello");
    }
    let name_b = payload.sub_bytes(off, off + name_len);
    off = off + name_len;
    match (from_utf8(name_b)) {
        Result.Err(_) => Result.Err("name is not utf-8"),
        Result.Ok(name) => {
            let size = read_be64(payload.sub_bytes(off, off + 8));
            off = off + 8;
            let chunk_size = read_be32(payload.sub_bytes(off, off + 4));
            Result.Ok(Hello { salt: salt, name: name, size: size, chunk_size: chunk_size })
        },
    }
}

pub fn nonce_for(index: int, dir: int) -> bytes {
    be64(index) + be32(dir)
}

pub fn aad_for(index: int, name: string, size: int) -> bytes {
    be64(index) + name.to_bytes() + be64(size)
}

pub fn send_hello(c: framing.Conn, h: Hello) -> Result<framing.Conn, string> {
    framing.write_frame(c, encode_hello(h))
}

pub fn recv_hello(c: framing.Conn) -> Result<(framing.Conn, Hello), string> {
    match (framing.read_frame(c, MAX_FRAME)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(pair) => {
            let (c2, payload) = pair;
            match (decode_hello(payload)) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(h) => Result.Ok((c2, h)),
            }
        },
    }
}

/// Sender: sends a nonce and verifies the receiver's HMAC response.
pub fn auth_as_sender(c: framing.Conn, key: bytes) -> Result<framing.Conn, string> {
    let nonce = crypto.random_bytes(16);
    match (framing.write_frame(c, nonce)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(c1) => match (framing.read_frame(c1, 64)) {
            Result.Err(e) => Result.Err(e),
            Result.Ok(pair) => {
                let (c2, resp) = pair;
                let expect = crypto.hmac_sha256(key, b"auth" + nonce);
                if (resp != expect) {
                    Result.Err("authentication failed (wrong password?)")
                } else {
                    Result.Ok(c2)
                }
            },
        },
    }
}

/// Receiver: reads the nonce and replies with HMAC.
pub fn auth_as_receiver(c: framing.Conn, key: bytes) -> Result<framing.Conn, string> {
    match (framing.read_frame(c, 64)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(pair) => {
            let (c1, nonce) = pair;
            let mac = crypto.hmac_sha256(key, b"auth" + nonce);
            framing.write_frame(c1, mac)
        },
    }
}

fn seal(key: bytes, nonce: bytes, aad: bytes, plain: bytes) -> Result<bytes, string> {
    match (crypto.chacha20poly1305_seal(key, nonce, aad, plain)) {
        Option.Some(ct) => Result.Ok(ct),
        Option.None => Result.Err("encryption failed"),
    }
}

fn open(key: bytes, nonce: bytes, aad: bytes, ct: bytes) -> Result<bytes, string> {
    match (crypto.chacha20poly1305_open(key, nonce, aad, ct)) {
        Option.Some(pt) => Result.Ok(pt),
        Option.None => Result.Err("decryption failed (tampered data or wrong key)"),
    }
}

/// Encrypts and sends a sender frame: data (`KIND_DATA` + bytes), start or done.
pub fn send_chunk(
    c: framing.Conn,
    key: bytes,
    index: int,
    name: string,
    size: int,
    kind: int,
    body: bytes
) -> Result<framing.Conn, string> {
    send_sealed(c, key, FROM_SENDER, index, name, size, kind, body)
}

/// Encrypts `kind` + `body` with the nonce of (`dir`, `index`) and sends it as one frame.
pub fn send_sealed(
    c: framing.Conn,
    key: bytes,
    dir: int,
    index: int,
    name: string,
    size: int,
    kind: int,
    body: bytes
) -> Result<framing.Conn, string> {
    let plain = bytes_of([kind]) + body;
    let nonce = nonce_for(index, dir);
    let aad = aad_for(index, name, size);
    match (seal(key, nonce, aad, plain)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(ct) => framing.write_frame(c, ct),
    }
}

pub struct RecvChunk {
    conn: framing.Conn,
    kind: int,
    body: bytes,
}

/// Reads and opens a sender frame.
pub fn recv_chunk(
    c: framing.Conn,
    key: bytes,
    index: int,
    name: string,
    size: int
) -> Result<RecvChunk, string> {
    recv_sealed(c, key, FROM_SENDER, index, name, size)
}

/// Reads one frame and opens it with the nonce of (`dir`, `index`).
pub fn recv_sealed(
    c: framing.Conn,
    key: bytes,
    dir: int,
    index: int,
    name: string,
    size: int
) -> Result<RecvChunk, string> {
    match (framing.read_frame(c, MAX_FRAME)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(pair) => {
            let (c2, ct) = pair;
            let nonce = nonce_for(index, dir);
            let aad = aad_for(index, name, size);
            match (open(key, nonce, aad, ct)) {
                Result.Err(e) => Result.Err(e),
                Result.Ok(plain) => {
                    if (plain.len() < 1) {
                        Result.Err("empty chunk")
                    } else {
                        Result.Ok(
                            RecvChunk {
                                conn: c2,
                                kind: plain[0] & 255,
                                body: plain.sub_bytes(1, plain.len())
                            }
                        )
                    }
                },
            }
        },
    }
}

/// What the receiver already holds: `offset` bytes whose SHA-256 is `prefix_digest`.
pub struct Resume {
    offset: int,
    prefix_digest: bytes,
}

pub fn encode_resume(r: Resume) -> bytes {
    be64(r.offset) + r.prefix_digest
}

pub fn decode_resume(body: bytes) -> Result<Resume, string> {
    if (body.len() != 8 + 32) {
        return Result.Err("invalid resume frame");
    }
    let offset = read_be64(body.sub_bytes(0, 8));
    if (offset < 0) {
        return Result.Err("invalid resume offset");
    }
    Result.Ok(Resume { offset: offset, prefix_digest: body.sub_bytes(8, 40) })
}

pub fn decode_start(body: bytes) -> Result<int, string> {
    if (body.len() != 8) {
        return Result.Err("invalid start frame");
    }
    let offset = read_be64(body);
    if (offset < 0) {
        return Result.Err("invalid start offset");
    }
    Result.Ok(offset)
}

pub fn derive(password: string, salt: bytes) -> bytes {
    kdf.derive_key(password, salt)
}

@test
fn hello_codec() {
    let h = Hello {
        salt: crypto.random_bytes(16),
        name: "foto.bin",
        size: 1024,
        chunk_size: DEFAULT_CHUNK
    };
    match (decode_hello(encode_hello(h))) {
        Result.Err(e) => panic(e),
        Result.Ok(h2) => {
            assert(h2.name == h.name);
            assert(h2.size == h.size);
            assert(h2.chunk_size == h.chunk_size);
            assert(h2.salt == h.salt);
        },
    }
}

@test
fn be64_roundtrip() {
    assert(read_be64(be64(0)) == 0);
    assert(read_be64(be64(255)) == 255);
    assert(read_be64(be64(1234567890123)) == 1234567890123);
}

@test
fn resume_codec() {
    let digest = crypto.sha256(b"prefix");
    match (decode_resume(encode_resume(Resume { offset: 1234567, prefix_digest: digest }))) {
        Result.Err(e) => panic(e),
        Result.Ok(r) => {
            assert_eq(r.offset, 1234567);
            assert(r.prefix_digest == digest);
        },
    }
    assert(decode_resume(b"short").is_err());
    match (decode_start(be64(42))) {
        Result.Err(e) => panic(e),
        Result.Ok(n) => assert_eq(n, 42),
    }
    assert(decode_start(b"").is_err());
}

@test
fn directions_never_share_a_nonce() {
    assert(nonce_for(0, FROM_SENDER) != nonce_for(0, FROM_RECEIVER));
    assert_eq(nonce_for(7, FROM_RECEIVER).len(), 12);
}
