// Rutas del manifiesto: relativas, POSIX y sin escapatoria. Las reglas son puras (sin
// disco) para que el receptor rechace un manifiesto hostil antes de tocar nada.

/// Longest accepted manifest path, in UTF-8 bytes.
pub const MAX_PATH: int = 1024;

/// `Ok(0)` when `p` is a safe relative path: `/`-separated, no leading `/`, no empty,
/// `.` or `..` component, no `\\` or NUL, at most `MAX_PATH` bytes.
pub fn check(p: string) -> Result<int, string> {
    if (p.len() == 0) {
        return Result.Err("empty path in manifest");
    }
    if (p.to_bytes().len() > MAX_PATH) {
        return Result.Err("path longer than ${MAX_PATH} bytes in manifest");
    }
    if (p.starts_with("/")) {
        return Result.Err("absolute path in manifest: ${p}");
    }
    if (p.contains("\\") || p.contains("\0")) {
        return Result.Err("invalid character in manifest path: ${p}");
    }
    for part in p.split("/") {
        if (part == "" || part == "." || part == "..") {
            return Result.Err("invalid component in manifest path: ${p}");
        }
    }
    Result.Ok(0)
}

/// Characters Windows does not allow in a file name (besides the separators and controls).
const WINDOWS_FORBIDDEN: [string] = ["<", ">", ":", "\"", "|", "?", "*"];

/// Device names Windows reserves, with or without an extension (`CON`, `nul.txt`, …).
const WINDOWS_RESERVED: [string] = [
    "con",
    "prn",
    "aux",
    "nul",
    "com1",
    "com2",
    "com3",
    "com4",
    "com5",
    "com6",
    "com7",
    "com8",
    "com9",
    "lpt1",
    "lpt2",
    "lpt3",
    "lpt4",
    "lpt5",
    "lpt6",
    "lpt7",
    "lpt8",
    "lpt9"
];

/// `Ok(0)` when every component of the (already `check`ed) manifest path can be created
/// on Windows: no `<>:"|?*` or control characters, no reserved device name, no trailing
/// dot or space. A Unix sender can name files that a Windows receiver cannot save.
pub fn check_windows(p: string) -> Result<int, string> {
    for part in p.split("/") {
        for c in WINDOWS_FORBIDDEN {
            if (part.contains(c)) {
                return Result.Err("${p}: '${c}' is not allowed in a Windows file name");
            }
        }
        for b in part.to_bytes() {
            if ((b & 255) < 32) {
                return Result.Err(
                    "${p}: control characters are not allowed in a Windows file name"
                );
            }
        }
        if (part.ends_with(".") || part.ends_with(" ")) {
            return Result.Err("${p}: a Windows file name cannot end in a dot or a space");
        }
        let stem = part.split(".")[0].trim().to_lower();
        if (WINDOWS_RESERVED.contains(stem)) {
            return Result.Err("${p}: '${part}' is a reserved device name on Windows");
        }
    }
    Result.Ok(0)
}

/// Whether this OS's usual file systems ignore case (NTFS, APFS by default): two manifest
/// paths that differ only in case would land on the same file there.
pub fn case_insensitive_fs() -> bool {
    platform() == "windows" || platform() == "macos"
}

/// The name a LOCAL path goes by: like `base_name`, but on Windows `\` separates too
/// (`fs.real_path` returns `C:\Users\…`). Elsewhere `\` is an ordinary character.
pub fn local_base_name(path: string) -> string {
    if (platform() == "windows") { base_name(path.replace("\\", "/")) } else { base_name(path) }
}

/// Joins a LOCAL directory and an entry name with this OS's separator.
pub fn join_local(dir: string, name: string) -> string {
    if (platform() == "windows") { dir + "\\" + name } else { dir + "/" + name }
}

/// Whether a LOCAL path ends in a separator (`/`, and `\` on Windows).
pub fn ends_in_separator(path: string) -> bool {
    path.ends_with("/") || platform() == "windows" && path.ends_with("\\")
}

/// The last component of `path` (`a/b/c.txt` → `c.txt`), ignoring trailing slashes.
pub fn base_name(path: string) -> string {
    let parts = path.split("/").filter(fn(s: string) -> bool { s != "" });
    if (parts.len() == 0) { path } else { parts[parts.len() - 1] }
}

/// Everything before the last `/` (`a/b/c.txt` → `a/b`); `"."` when there is none.
pub fn parent(path: string) -> string {
    let parts = path.split("/");
    if (parts.len() <= 1) {
        return ".";
    }
    let head = parts.slice(0, parts.len() - 1).join("/");
    if (head == "") { "/" } else { head }
}

@test
fn safe_paths_pass() {
    assert(check("a.txt").is_ok());
    assert(check("fotos/2026/img 01.jpg").is_ok());
    assert(check("ñandú/..hidden").is_ok());
}

@test
fn escaping_paths_are_rejected() {
    assert(check("").is_err());
    assert(check("/etc/passwd").is_err());
    assert(check("../x").is_err());
    assert(check("a/../../x").is_err());
    assert(check("a/./b").is_err());
    assert(check("a//b").is_err());
    assert(check("a/").is_err());
    assert(check("a\\b").is_err());
    assert(check("a\0b").is_err());
    assert(check("x".repeat(MAX_PATH + 1)).is_err());
}

@test
fn names_and_parents() {
    assert_eq(base_name("a/b/c.txt"), "c.txt");
    assert_eq(base_name("dir/"), "dir");
    assert_eq(base_name("c.txt"), "c.txt");
    assert_eq(parent("a/b/c.txt"), "a/b");
    assert_eq(parent("c.txt"), ".");
    assert_eq(parent("/c.txt"), "/");
}

@test
fn names_windows_cannot_create_are_flagged() {
    assert(check_windows("fotos/2026/img 01.jpg").is_ok());
    assert(check_windows("ñandú/..hidden").is_ok());
    assert(check_windows("a:b.txt").is_err());
    assert(check_windows("dir/what?.txt").is_err());
    assert(check_windows("x/CON").is_err());
    assert(check_windows("nul.txt").is_err());
    assert(check_windows("Com1.log").is_err());
    assert(check_windows("console.txt").is_ok());
    assert(check_windows("trailing.").is_err());
    assert(check_windows("dir /x").is_err());
    assert(check_windows("tab\there").is_err());
}

@test
fn local_names_follow_the_platform_separators() {
    assert_eq(local_base_name("/a/b/c.txt"), "c.txt");
    if (platform() == "windows") {
        assert_eq(local_base_name("C:\\Users\\x\\fotos"), "fotos");
        assert(ends_in_separator("C:\\inbox\\"));
    } else {
        assert_eq(local_base_name("/tmp/a\\b"), "a\\b");
        assert(!ends_in_separator("inbox\\"));
    }
    assert(ends_in_separator("inbox/"));
}
