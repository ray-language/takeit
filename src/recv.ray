// Modo recv: conecta, autentica y escribe a disco por streaming.
import std/net;
import std/fs;
import std/crypto;
import framing;
import protocol;
import password;
import kdf;
import progress;
import streamhash;

pub struct RecvOpts {
    host: string,
    port: int,
    password: string,
    out: string,
    timeout_ms: int,
    /// Resume from a `<out>.takeit.partial` left by an interrupted transfer (default).
    resume: bool,
}

pub fn run(opts: RecvOpts) -> int {
    // tcp_connect_timeout (raylang M122): a hung or dropping host fails fast instead of
    // parking the connect forever. Reuse the idle timeout; fall back to 10s when disabled.
    let connect_ms = if (opts.timeout_ms > 0) { opts.timeout_ms } else { 10000 };
    match (net.tcp_connect_timeout(opts.host, opts.port, connect_ms)) {
        Result.Err(e) => {
            eprint("could not connect: " + e);
            1
        },
        Result.Ok(sock) => {
            var c0 = framing.from_handle(sock);
            c0 = framing.set_timeout(c0, opts.timeout_ms);
            match (protocol.recv_hello(c0)) {
                Result.Err(e) => {
                    eprint(e);
                    framing.close_conn(c0);
                    1
                },
                Result.Ok(pair) => {
                    let (c1, hello) = pair;
                    let key = kdf.derive_key(password.normalize(opts.password), hello.salt);
                    match (protocol.auth_as_receiver(c1, key)) {
                        Result.Err(e) => {
                            eprint(e);
                            framing.close_conn(c1);
                            1
                        },
                        Result.Ok(c2) => {
                            let out_path = if (opts.out.len() > 0) { opts.out } else { hello.name };
                            eprint(
                                "receiving "
                                    + hello.name
                                    + " ("
                                    + progress.format_bytes(hello.size)
                                    + ")"
                            );
                            let code = match (receive_file(c2, key, hello, out_path, opts.resume)) {
                                Result.Err(e) => {
                                    eprint("\n" + e);
                                    let tmp = partial_path(out_path);
                                    if (fs.exists(tmp)) {
                                        eprint(
                                            "partial file kept: "
                                                + tmp
                                                + " (receive the same file again to resume)"
                                        );
                                    }
                                    1
                                },
                                Result.Ok(got) => {
                                    let note = if (got.offset > 0) {
                                        ", resumed at " + progress.format_bytes(got.offset)
                                    } else {
                                        ""
                                    };
                                    print(
                                        "Saved: "
                                            + out_path
                                            + " ("
                                            + progress.format_bytes(got.size)
                                            + note
                                            + ")"
                                    );
                                    0
                                },
                            };
                            framing.close_conn(c2);
                            code
                        },
                    }
                },
            }
        },
    }
}

/// Where the bytes of `out_path` accumulate until the transfer is complete and verified.
/// It survives an interrupted transfer: the next one resumes from it.
pub fn partial_path(out_path: string) -> string {
    out_path + ".takeit.partial"
}

/// A finished transfer: the offset it resumed from (0 = from scratch) and the file size.
pub struct Received {
    offset: int,
    size: int,
}

/// What the receiver offers to resume from: the partial file's length when it can be a
/// prefix of this file (0 otherwise), with `hh` already fed with those bytes.
fn offer_from(tmp: string, size: int, resume: bool, hh: int) -> Result<protocol.Resume, string> {
    let held = if (resume) {
        match (fs.file_size(tmp)) {
            Result.Ok(n) => if (n <= size) { n } else { 0 },
            Result.Err(_) => 0,
        }
    } else {
        0
    };
    if (held == 0) {
        return Result.Ok(protocol.Resume { offset: 0, prefix_digest: crypto.sha256(b"") });
    }
    match (streamhash.prefix_of(tmp, held, protocol.DEFAULT_CHUNK, hh)) {
        Result.Err(e) => Result.Err(e),
        Result.Ok(d) => Result.Ok(protocol.Resume { offset: held, prefix_digest: d }),
    }
}

/// Receiver side of an authenticated session: offers what `<out_path>.takeit.partial`
/// already holds, then writes the rest of the stream after it. On success the partial
/// file is synced and renamed to `out_path`; on a transport failure it is KEPT so the
/// next transfer resumes; only a failed integrity check (digest or size) removes it.
pub fn receive_file(
    c: framing.Conn,
    key: bytes,
    hello: protocol.Hello,
    out_path: string,
    resume: bool
) -> Result<Received, string> {
    let tmp = partial_path(out_path);
    let fresh = match (streamhash.init()) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(h) => h,
    };
    let offer = match (offer_from(tmp, hello.size, resume, fresh)) {
        Result.Err(e) => {
            let _ = streamhash.digest(fresh);
            return Result.Err(e);
        },
        Result.Ok(r) => r,
    };
    let c1 = match (protocol.send_sealed(
        c,
        key,
        protocol.FROM_RECEIVER,
        0,
        hello.name,
        hello.size,
        protocol.KIND_RESUME,
        protocol.encode_resume(offer)
    )) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(c1) => c1,
    };
    let start_frame = match (protocol.recv_chunk(c1, key, 0, hello.name, hello.size)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(ch) => ch,
    };
    if (start_frame.kind != protocol.KIND_START) {
        return Result.Err("expected a start frame, got kind " + to_string(start_frame.kind));
    }
    let start = match (protocol.decode_start(start_frame.body)) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(n) => n,
    };
    // The sender either takes the whole offer or starts over; anything else would splice
    // bytes we do not have.
    if (start != 0 && start != offer.offset) {
        return Result.Err(
            "sender wants to start at "
                + to_string(start)
                + " but "
                + to_string(offer.offset)
                + " bytes are held"
        );
    }
    let hh = if (start == 0 && offer.offset > 0) {
        match (streamhash.restart(fresh)) {
            Result.Err(e) => {
                return Result.Err(e);
            },
            Result.Ok(h) => h,
        }
    } else {
        fresh
    };
    if (start > 0) {
        eprint("resuming at " + progress.format_bytes(start));
    }
    // Keep one write handle open for the whole transfer: chunks go straight to it with
    // fs.write_bytes (raylang M115.1) instead of reopening the file per chunk, and fs.sync
    // before the rename makes the saved file durable across a power loss, not just a crash.
    let fh = match (fs.open(tmp, if (start > 0) { "a" } else { "w" })) {
        Result.Err(e) => {
            return Result.Err(e);
        },
        Result.Ok(h) => h,
    };
    var closed = false;
    // Only a failed integrity check condemns the partial file; any other failure leaves
    // authenticated bytes behind that the next transfer can build on.
    var discard = false;

    var conn = start_frame.conn;
    var index = 1;
    var written = start;
    var err = "";
    var meter = progress.start_from("receiving", hello.size, start);

    while (err.len() == 0) {
        match (protocol.recv_chunk(conn, key, index, hello.name, hello.size)) {
            Result.Err(e) => {
                err = e;
            },
            Result.Ok(ch) => {
                conn = ch.conn;
                if (ch.kind == protocol.KIND_DATA) {
                    if (written + ch.body.len() > hello.size) {
                        err = "sender sent more than the announced "
                            + to_string(hello.size)
                            + " bytes";
                        discard = true;
                    } else {
                        match (fs.write_bytes(fh, ch.body)) {
                            Result.Err(e) => {
                                err = e;
                            },
                            Result.Ok(_) => {
                                match (streamhash.update(hh, ch.body)) {
                                    Result.Err(e) => {
                                        err = e;
                                    },
                                    Result.Ok(_) => {
                                        written = written + ch.body.len();
                                        index = index + 1;
                                        meter = progress.tick(meter, written);
                                    },
                                }
                            },
                        }
                    }
                } else if (ch.kind == protocol.KIND_DONE) {
                    match (streamhash.digest(hh)) {
                        Result.Err(e) => {
                            err = e;
                        },
                        Result.Ok(digest) => {
                            if (digest != ch.body) {
                                err = "checksum mismatch";
                                discard = true;
                            } else if (written != hello.size) {
                                err = "unexpected size: " + to_string(written);
                                discard = true;
                            } else {
                                // Durable then atomic: fsync the bytes, close, then rename into place.
                                match (fs.sync(fh)) {
                                    Result.Err(e) => {
                                        err = e;
                                    },
                                    Result.Ok(_) => {
                                        let _ = close(fh);
                                        closed = true;
                                        match (fs.rename(tmp, out_path)) {
                                            Result.Err(e) => {
                                                err = e;
                                            },
                                            Result.Ok(_) => {
                                                match (framing.write_frame(conn, b"OK")) {
                                                    Result.Err(e) => {
                                                        err = e;
                                                    },
                                                    Result.Ok(_) => {
                                                        progress.finish(meter);
                                                        break;
                                                    },
                                                }
                                            },
                                        }
                                    },
                                }
                            }
                        },
                    }
                } else {
                    err = "unknown chunk type: " + to_string(ch.kind);
                }
            },
        }
    }

    if (err.len() > 0) {
        if (!closed) {
            let _ = close(fh);
        }
        if (discard) {
            let _ = fs.remove_file(tmp);
        }
        Result.Err(err)
    } else {
        Result.Ok(Received { offset: start, size: written })
    }
}
